# Copy to .streamlit/secrets.toml (never commit the real file).
# On Streamlit Community Cloud paste the same line into the app's Secrets box.
#
# Get the connection string from MongoDB Atlas:
#   Database -> Connect -> Drivers -> copy the mongodb+srv:// URI
# and replace <username>/<password> with your database user.
MONGODB_URI = "mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# For a throwaway local demo without Atlas (data lost on restart):
# MONGODB_URI = "mongomock://local"
